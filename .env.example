# Copy to .env.local. Never commit real secrets.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set true to require verification links at sign-up and sign-in. Restart the app after changing.
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=MicroJobs <accounts@your-verified-domain.com>
# Local uploads are private files in storage/uploads (default; no bucket needed).
STORAGE_DRIVER=local
# Optional: set STORAGE_DRIVER=s3 to use a private S3-compatible bucket.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
