# Copy to .env.local. Never commit real secrets.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set true to require verification links at sign-up and sign-in. Restart the app after changing.
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=MicroJobs <accounts@your-verified-domain.com>
# Private bucket. S3 or R2 endpoint; no public bucket access required.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
