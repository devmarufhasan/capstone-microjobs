{
  "name": "microjobs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u BETTER_AUTH_URL -u EMAIL_FROM -u EMAIL_VERIFICATION_ENABLED next dev --port 8081",
    "build": "next build",
    "start": "next start --port 8081",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "admin:promote": "tsx scripts/create-admin.mts",
    "build:webpack": "next build --webpack",
    "format": "prettier --write app components lib scripts tests drizzle.config.ts vitest.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
